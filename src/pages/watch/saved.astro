---
import WatchScreen from "../../components/WatchScreen.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="読み込み中">
  <WatchScreen video={null} title="読み込み中" />
  <p class="missing" data-missing hidden>このブラウザには、その動画の字幕がありません。<a href="/">一覧へ戻る</a></p>
</Layout>

<script>
  import { fillSavedWatch } from "../../scripts/fill-saved";

  fillSavedWatch();
</script>

<style lang="scss">
  @use "../../styles/variables" as *;

  .missing {
    max-width: 640px;
    margin: 48px auto;
    padding: 0 20px;
    color: $color-text;
    font-size: 16px;
    line-height: 1.8;

    @media (max-width: $breakpoint-sp) {
      margin-top: 32px;
      padding: 0 16px;
      font-size: 15px;
    }

    a {
      color: $color-blue;
    }
  }
</style>
