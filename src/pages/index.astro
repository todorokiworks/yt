---
import Layout from "../layouts/Layout.astro";
import { listVideos } from "../lib/videos";

const videos = listVideos();
---

<Layout title="yt">
  <main class="home">
    <p class="home__label">日英スクリプト</p>
    <h1 class="home__title">動画を選ぶ</h1>
    {
      videos.length === 0 ? (
        <p class="home__empty">取り込み済みの動画はまだありません。</p>
      ) : (
        <ul class="home__list">
          {videos.map((video) => (
            <li>
              <a class="home-card" href={`/watch/${video.id}`}>
                <span class="home-card__title">{video.title}</span>
                <span class="home-card__meta">{video.phrases.length} フレーズ</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>

<style lang="scss">
  @use "../styles/variables" as *;

  .home {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 20px 64px;

    @media (max-width: $breakpoint-sp) {
      padding: 24px 16px 48px;
    }

    &__label {
      margin: 0;
      color: $color-blue;
      font-family: $font-family-num;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
    }

    &__title {
      margin: 8px 0 24px;
      color: $color-navy;
      font-size: 28px;

      @media (max-width: $breakpoint-sp) {
        font-size: 22px;
      }
    }

    &__empty {
      margin: 0;
      color: $color-text-sub;
    }

    &__list {
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  .home-card {
    display: block;
    margin-bottom: 12px;
    padding: 18px 20px;
    background: $color-white;
    border: 1px solid $color-border;
    border-radius: 12px;
    color: $color-navy;
    text-decoration: none;

    @media (max-width: $breakpoint-sp) {
      padding: 16px;
    }

    &__title {
      display: block;
      font-size: 18px;
      font-weight: 700;
      line-height: 1.5;

      @media (max-width: $breakpoint-sp) {
        font-size: 16px;
      }
    }

    &__meta {
      display: block;
      margin-top: 6px;
      color: $color-text-sub;
      font-family: $font-family-num;
      font-size: 13px;
    }
  }
</style>
